# LawSaathi env template — copy to .env (api/) and .env.local (web/) as needed.
# Give Nayan the values when a ticket asks; nothing here is secret.

# --- LLM (T3) ---
# Get from: https://console.groq.com
GROQ_API_KEY=
# Get from: https://openrouter.ai (fallback)
OPENROUTER_API_KEY=

# --- Web search + extraction (T5, T13) ---
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# --- Voice (T8) ---
# Get from: https://www.sarvam.ai
SARVAM_API_KEY=

# --- Vector DB (T2) ---
# Get from: https://cloud.qdrant.io (free tier)
QDRANT_URL=
QDRANT_API_KEY=

# --- App DB (T1) ---
# Get from: https://neon.tech (free Postgres)
DATABASE_URL=

# --- Auth: Neon Managed Better Auth (T1, ADR-0008) ---
# NEON_AUTH_BASE_URL: Neon console -> project -> Branch -> Auth -> Configuration (your Auth URL)
# NEON_AUTH_COOKIE_SECRET: generate with `openssl rand -base64 32`
# INTERNAL_API_SECRET: shared secret between web BFF and api; generate with `openssl rand -base64 32`
#   Put it in BOTH api/.env and web/.env.local (same value).
# FASTAPI_URL: web server-side only; http://localhost:8000 locally, Render URL in prod.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
INTERNAL_API_SECRET=
FASTAPI_URL=http://localhost:8000

# --- Observability + eval (T3, T10) ---
# Get from: https://smith.langchain.com
# Free tier allows 5k base traces/month; one question costs ~6 node traces.
# LAWSAATHI_TRACE=off (default) | errors (trace only bad runs) | all
# (trace every node of every run — expensive, debugging only).
LAWSAATHI_TRACE=errors
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lawsathi

# --- Datasets (T2, T10; HF_TOKEN only if gated download blocks) ---
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Phase 2 only (T11, ignore for MVP) ---
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
