# LawSaathi env template — copy to .env (api/) and .env.local (web/) as needed.
# Give Nayan the values when a ticket asks; nothing here is secret.

# --- LLM (T3) ---
# Get from: https://console.groq.com
GROQ_API_KEY=
# Get from: https://openrouter.ai (fallback)
OPENROUTER_API_KEY=

# --- Web search + extraction (T5, T13) ---
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# --- Voice (T8) ---
# Get from: https://www.sarvam.ai
SARVAM_API_KEY=

# --- Vector DB (T2) ---
# Get from: https://cloud.qdrant.io (free tier)
QDRANT_URL=
QDRANT_API_KEY=

# --- App DB (T1) ---
# Get from: https://neon.tech (free Postgres)
DATABASE_URL=

# --- Auth: Neon Auth = Stack Auth (T1) ---
# Get from: Neon console -> your project -> Auth section.
# Backend reads STACK_PROJECT_ID (or NEXT_PUBLIC_STACK_PROJECT_ID).
# Web reads all three NEXT_PUBLIC_* + secret from web/.env.local.
STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# --- Observability + eval (T3, T10) ---
# Get from: https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=lawsathi

# --- Datasets (T2, T10; HF_TOKEN only if gated download blocks) ---
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Phase 2 only (T11, ignore for MVP) ---
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
